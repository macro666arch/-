# ===== 复制到 Render/Docker 的 Environment 里逐项填写真实值 =====

# DeepSeek 大模型（必填，用你本地 .env 里的同一套值）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 数据库（Supabase → Connect → Session pooler，端口 5432，必须带 ?sslmode=require）
# 形如 postgresql://postgres.<项目ID>:<密码>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# 密码含 ! + @ 等特殊字符时必须做 URL 编码（!→%21、+→%2B、@→%40），否则连接串会被截断。
# 库里已执行 CREATE EXTENSION vector / "uuid-ossp" 并导入 knowledge_chunks / users 等数据。
DATABASE_URL=

# 缓存（Upstash 控制台复制 REST/Redis URL，形如 rediss://default:xxx@host:6379）
REDIS_URL=

PORT=3001
NODE_ENV=production

# 加密与登录（用你本地 .env 里的同一套值，必须一致否则本地老 token 失效）
ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_DAYS=

# 向量服务（Render 上 embedding 服务的内网地址，部署完 embedding 后填）
EMBEDDING_URL=

# 飞书提醒（可留空，云端不启用）
FEISHU_WEBHOOK_URL=
ENABLE_FEISHU_REMIND=false
FEISHU_REMIND_HOUR=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
ENABLE_FRESHNESS_CRON=false

OCR_PROVIDER=tesseract
NAU_KB_PATH=./knowledge-base/NAU_KNOWLEDGE_BASE.md

# 登录限制
ALLOWED_EMAIL_DOMAINS=cuc.edu.cn
WHITELIST_EMAILS=
